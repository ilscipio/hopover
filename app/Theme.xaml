<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colour tokens: one dark theme. -->
  <Color x:Key="AccentA">#22D3EE</Color>
  <Color x:Key="AccentB">#6366F1</Color>
  <Color x:Key="AccentC">#A855F7</Color>
  <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
  <SolidColorBrush x:Key="Surface" Color="#12151C"/>
  <SolidColorBrush x:Key="Surface2" Color="#181C25"/>
  <SolidColorBrush x:Key="Surface3" Color="#222734"/>
  <SolidColorBrush x:Key="Stroke" Color="#262B37"/>
  <SolidColorBrush x:Key="StrokeHi" Color="#363D4D"/>
  <SolidColorBrush x:Key="Text" Color="#F3F4F6"/>
  <SolidColorBrush x:Key="TextDim" Color="#A1A8B6"/>
  <SolidColorBrush x:Key="TextFaint" Color="#6B7280"/>
  <SolidColorBrush x:Key="Accent" Color="#7C8CFF"/>
  <SolidColorBrush x:Key="Success" Color="#34D399"/>
  <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
  <SolidColorBrush x:Key="Danger" Color="#F87171"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#1534D399"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#14FBBF24"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#1A6366F1"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#22D3EE" Offset="0"/>
    <GradientStop Color="#6366F1" Offset="0.55"/>
    <GradientStop Color="#A855F7" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#22D3EE" Offset="0"/>
    <GradientStop Color="#6366F1" Offset="0.6"/>
    <GradientStop Color="#A855F7" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Glow" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.7">
    <GradientStop Color="#286366F1" Offset="0"/>
    <GradientStop Color="#0022D3EE" Offset="1"/>
  </RadialGradientBrush>

  <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>

  <!-- The logo: a file hops from one box to the other. Also the source of the .ico. -->
  <DrawingImage x:Key="Logo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource AccentGradient}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,64,64" RadiusX="16" RadiusY="16"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#8CFFFFFF">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="9,39,15,15" RadiusX="4" RadiusY="4"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFFFF">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="40,39,15,15" RadiusX="4" RadiusY="4"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 16.5,34 C 19,13 44,12 47.5,31">
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="5" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 40.5,27 L 47.5,32.5 L 53,25">
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Text -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="Dim" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="21"/>
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- Cards -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface3}"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="{StaticResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="22,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="glow" CornerRadius="12" Background="{StaticResource AccentGradientH}" Opacity="0">
              <Border.Effect>
                <BlurEffect Radius="22"/>
              </Border.Effect>
            </Border>
            <Border x:Name="bd" CornerRadius="12" Background="{StaticResource AccentGradientH}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
              <Setter TargetName="glow" Property="Opacity" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>

  <Style x:Key="Caption" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8">
            <TextBlock x:Name="tx" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#E5484D"/>
              <Setter TargetName="tx" Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The two big choice cards on the start page -->
  <Style x:Key="ChoiceCard" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="lift">
            <Border x:Name="glow" CornerRadius="20" Background="{StaticResource AccentGradient}" Opacity="0" Margin="6">
              <Border.Effect>
                <BlurEffect Radius="30"/>
              </Border.Effect>
            </Border>
            <Border x:Name="bd" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="28">
              <ContentPresenter/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#5A6BFF"/>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
              <Setter TargetName="glow" Property="Opacity" Value="0.22"/>
              <!-- Setter targets must be elements, not transforms: replace the whole transform. -->
              <Setter TargetName="lift" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="-3"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check box: rounded square, gradient when on -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource StrokeHi}" BorderThickness="1.5" VerticalAlignment="Center">
              <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource AccentGradient}"/>
              <Setter TargetName="box" Property="BorderThickness" Value="0"/>
              <Setter TargetName="tick" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch (a CheckBox) for the step options -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="{StaticResource Surface3}"
                    BorderBrush="{StaticResource StrokeHi}" BorderThickness="1">
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource TextDim}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradientH}"/>
              <Setter TargetName="track" Property="BorderThickness" Value="0"/>
              <Setter TargetName="knob" Property="Fill" Value="White"/>
              <Setter TargetName="knob" Property="Margin" Value="22,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control (RadioButtons) -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" CornerRadius="8" Padding="12,8" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress bar: rounded track, gradient fill -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="Maximum" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <!-- A radius larger than half the height draws a lens, not a pill: keep it small. -->
            <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Surface3}"/>
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource AccentGradientH}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scroll bars -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{StaticResource StrokeHi}"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{StaticResource StrokeHi}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Lists without selection chrome -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,9">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A turning arc for "working" -->
  <Style x:Key="Spinner" TargetType="ContentControl">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox>
            <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform/>
              </Grid.RenderTransform>
              <!-- The trigger sits on the turning element itself: a template-level trigger can
                   fire before the template's names exist (spinners inside data templates). -->
              <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360"
                                       Duration="0:0:0.9" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>
              <Ellipse Stroke="{StaticResource Surface3}" StrokeThickness="3"/>
              <Path Data="M 12,1.5 A 10.5,10.5 0 0 1 22.5,12" Stroke="{StaticResource AccentGradient}" StrokeThickness="3"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One row of the step timeline -->
  <DataTemplate x:Key="StepTemplate">
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Rectangle x:Name="line" Width="2" Fill="{StaticResource Stroke}" HorizontalAlignment="Center" Margin="0,28,0,-4" RadiusX="1" RadiusY="1"/>
      <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,2,0,0">
        <Ellipse x:Name="ring" Stroke="{StaticResource StrokeHi}" StrokeThickness="2" Fill="{StaticResource Bg}"/>
        <ContentControl x:Name="spin" Style="{StaticResource Spinner}" Width="26" Height="26" Visibility="Collapsed"/>
        <TextBlock x:Name="glyph" Style="{StaticResource Glyph}" FontSize="12" Foreground="#0B0D12"/>
      </Grid>
      <StackPanel Grid.Column="1" Margin="10,3,0,18">
        <TextBlock x:Name="label" Text="{Binding Label}" FontSize="14" Foreground="{StaticResource TextDim}"/>
        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="line" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="running">
        <Setter TargetName="spin" Property="Visibility" Value="Visible"/>
        <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}"/>
        <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="done">
        <Setter TargetName="ring" Property="Fill" Value="{StaticResource Success}"/>
        <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Success}"/>
        <Setter TargetName="glyph" Property="Text" Value="&#xE73E;"/>
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}"/>
        <Setter TargetName="line" Property="Fill" Value="#5534D399"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="failed">
        <Setter TargetName="ring" Property="Fill" Value="{StaticResource Danger}"/>
        <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Danger}"/>
        <Setter TargetName="glyph" Property="Text" Value="&#xE711;"/>
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource Danger}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="skipped">
        <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Surface3}"/>
        <Setter TargetName="glyph" Property="Text" Value="&#xE738;"/>
        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource TextFaint}"/>
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextFaint}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
