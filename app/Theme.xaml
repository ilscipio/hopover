<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Four inks, printed in this ratio: concrete 46, ink 30, steel 14, signal 10. Paper is only for tickets and fields. -->
  <SolidColorBrush x:Key="Bg" Color="#DCDDDD"/>
  <SolidColorBrush x:Key="Paper" Color="#F2F2F1"/>
  <SolidColorBrush x:Key="Ink" Color="#111213"/>
  <SolidColorBrush x:Key="Ink2" Color="#2E3033"/>
  <SolidColorBrush x:Key="Steel" Color="#54575B"/>
  <SolidColorBrush x:Key="Light" Color="#A5A8AC"/>
  <SolidColorBrush x:Key="Signal" Color="#FF5A1F"/>
  <SolidColorBrush x:Key="Rust" Color="#C63D0C"/>
  <SolidColorBrush x:Key="RustDark" Color="#A8320A"/>
  <SolidColorBrush x:Key="Veil" Color="#CC111213"/>

  <!-- Hazard band: only while data moves. -->
  <LinearGradientBrush x:Key="Hazard" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="19.8,19.8">
    <GradientStop Color="#111213" Offset="0"/>
    <GradientStop Color="#111213" Offset="0.5"/>
    <GradientStop Color="#FF5A1F" Offset="0.5"/>
    <GradientStop Color="#FF5A1F" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HazardFine" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="8.5,8.5">
    <GradientStop Color="#111213" Offset="0"/>
    <GradientStop Color="#111213" Offset="0.5"/>
    <GradientStop Color="#FF5A1F" Offset="0.5"/>
    <GradientStop Color="#FF5A1F" Offset="1"/>
  </LinearGradientBrush>

  <!-- Static fonts, unpacked from the exe into %LOCALAPPDATA%\Hopover\fonts (WPF ignores variable-font axes). -->
  <FontFamily x:Key="Display">@FONTDIR@#Hop Display, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayBlack">@FONTDIR@#Hop Display Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Stencil">@FONTDIR@#Hop Stencil, Segoe UI</FontFamily>
  <FontFamily x:Key="StencilBlack">@FONTDIR@#Hop Stencil Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">@FONTDIR@#Hop Body, Segoe UI</FontFamily>
  <FontFamily x:Key="BodySemi">@FONTDIR@#Hop Body Semi, Segoe UI</FontFamily>
  <FontFamily x:Key="Mono">@FONTDIR@#Hop Mono, Consolas</FontFamily>
  <FontFamily x:Key="MonoSemi">@FONTDIR@#Hop Mono Semi, Consolas</FontFamily>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>

  <!-- The mark: the first letter of the name. Stem = the PC you leave, arch = everything in mid-air. -->
  <DrawingImage x:Key="Logo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="14,8,18,84"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#4D111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="38,90,49,2"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M45,84 V56 A17,17 0 0 1 79,56 V84">
          <GeometryDrawing.Pen><Pen Brush="#FF5A1F" Thickness="16"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <!-- The heavier 24 px cut as the h of the wordmark (cropped to the letter). -->
  <DrawingImage x:Key="LogoH">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="8,0,84,100"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="10,8,24,84"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M47,84 V58 A16,16 0 0 1 79,58 V84">
          <GeometryDrawing.Pen><Pen Brush="#FF5A1F" Thickness="22"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <!-- App icons: SIGNAL tile with the ink mark. 48 px and up use the normal cut, 24 and 20 the heavier cut, 16 the heaviest. -->
  <DrawingImage x:Key="LogoIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FF5A1F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry></GeometryDrawing>
        <DrawingGroup>
          <DrawingGroup.Transform><MatrixTransform Matrix="0.58,0,0,0.58,21,21"/></DrawingGroup.Transform>
          <GeometryDrawing Brush="#111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="14,8,18,84"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M45,84 V56 A17,17 0 0 1 79,56 V84">
            <GeometryDrawing.Pen><Pen Brush="#111213" Thickness="16"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="LogoIcon24">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FF5A1F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry></GeometryDrawing>
        <DrawingGroup>
          <DrawingGroup.Transform><MatrixTransform Matrix="0.66,0,0,0.66,17,17"/></DrawingGroup.Transform>
          <GeometryDrawing Brush="#111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="10,8,24,84"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M47,84 V58 A16,16 0 0 1 79,58 V84">
            <GeometryDrawing.Pen><Pen Brush="#111213" Thickness="22"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="LogoIcon16">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FF5A1F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry></GeometryDrawing>
        <DrawingGroup>
          <DrawingGroup.Transform><MatrixTransform Matrix="0.72,0,0,0.72,14,14"/></DrawingGroup.Transform>
          <GeometryDrawing Brush="#111213"><GeometryDrawing.Geometry><RectangleGeometry Rect="8,6,28,88"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M49,88 V60 A15,15 0 0 1 79,60 V88">
            <GeometryDrawing.Pen><Pen Brush="#111213" Thickness="26"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <!-- Coffee cup for the coupon and the coffee button. -->
  <DrawingImage x:Key="Cup">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,40,40"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M7,15 H27 V28 A6,6 0 0 1 21,34 H13 A6,6 0 0 1 7,28 Z M27,18 H30 A4,4 0 0 1 30,26 H27">
          <GeometryDrawing.Pen><Pen Brush="#111213" Thickness="2.5"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13,11 Q11,8 13,5 M19,11 Q17,8 19,5">
          <GeometryDrawing.Pen><Pen Brush="#FF5A1F" Thickness="2.5"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="CupLight">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,40,40"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M7,15 H27 V28 A6,6 0 0 1 21,34 H13 A6,6 0 0 1 7,28 Z M27,18 H30 A4,4 0 0 1 30,26 H27">
          <GeometryDrawing.Pen><Pen Brush="#DCDDDD" Thickness="2.2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13,11 Q11,8 13,5 M19,11 Q17,8 19,5">
          <GeometryDrawing.Pen><Pen Brush="#FF5A1F" Thickness="2.2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Geometry x:Key="GlyphMin">M0,5 H10</Geometry>
  <Geometry x:Key="GlyphMax">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
  <Geometry x:Key="GlyphRestore">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
  <Geometry x:Key="GlyphClose">M0,0 L10,10 M10,0 L0,10</Geometry>

  <!-- Text -->
  <!-- Font, size and colour are inherited from the window, so a button can set them for its caption. -->
  <Style TargetType="TextBlock">
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayBlack}"/>
    <Setter Property="FontSize" Value="46"/>
    <Setter Property="LineHeight" Value="46"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="22"/>
  </Style>
  <Style x:Key="Dim" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="LineHeight" Value="22"/>
  </Style>
  <Style x:Key="Semi" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodySemi}"/>
  </Style>
  <!-- Mono caption: sheet labels, crate codes, paths. -->
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Steel}"/>
  </Style>
  <!-- Stencil: units, crate labels, stamps. -->
  <Style x:Key="StencilText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Stencil}"/>
    <Setter Property="FontSize" Value="15"/>
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Paper}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style x:Key="Rule" TargetType="Rectangle">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Fill" Value="{StaticResource Ink}"/>
  </Style>

  <!-- Buttons: outline by default. The ink block with a signal cap is the one that moves data. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Ink}"/>
              <Setter TargetName="cp" Property="TextElement.Foreground" Value="{StaticResource Bg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="68"/>
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="bd" Background="{StaticResource Ink}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,8,0" TextElement.Foreground="{StaticResource Bg}"/>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Signal}">
              <Path Data="M4,12 H19 M13,6 L19,12 L13,18" Stroke="{StaticResource Ink}" StrokeThickness="2.5" Width="24" Height="24"
                    Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Ink2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A plain text link: underlined, no frame. -->
  <Style x:Key="Ghost" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemi}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Padding="2,8" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                     TextDecorations="Underline" Text="{TemplateBinding Content}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Foreground" Value="{StaticResource RustDark}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="t" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- On an ink panel: ground-coloured block. -->
  <Style x:Key="OnInk" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Bg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="60"/>
    <Setter Property="FontSize" Value="19"/>
  </Style>
  <Style x:Key="GhostOnInk" TargetType="Button" BasedOn="{StaticResource Ghost}">
    <Setter Property="Foreground" Value="{StaticResource Bg}"/>
  </Style>

  <Style x:Key="Caption" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent">
            <Path x:Name="g" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Ink}"/>
              <Setter TargetName="g" Property="Stroke" Value="{StaticResource Bg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent">
            <Path x:Name="g" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Signal}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The two big choices on the start page. -->
  <Style x:Key="ChoiceCard" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="28,30,28,26">
              <ContentPresenter/>
            </Border>
            <Rectangle x:Name="cap" Height="10" VerticalAlignment="Top" Fill="{StaticResource HazardFine}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="cap" Property="Visibility" Value="Visible"/>
              <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs: paper fields with an ink rule. -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Signal}"/>
    <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{StaticResource Paper}" BorderBrush="{StaticResource Steel}" BorderThickness="1.5">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
              <Setter TargetName="bd" Property="BorderThickness" Value="2.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Signal}"/>
    <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{StaticResource Paper}" BorderBrush="{StaticResource Steel}" BorderThickness="1.5">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
              <Setter TargetName="bd" Property="BorderThickness" Value="2.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check box: square, ink fill with a ground tick. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="22" Height="22" Background="Transparent" BorderBrush="{StaticResource Ink}" BorderThickness="2" VerticalAlignment="Top" Margin="0,1,0,0">
              <Path x:Name="tick" Data="M4,10 L8.5,14.5 L16.5,5" Stroke="{StaticResource Bg}" StrokeThickness="2.5" Stretch="None" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}"/>
              <Setter TargetName="tick" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Steel}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch: a square track and a square knob. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="track" Grid.Column="1" Width="42" Height="22" Background="Transparent" BorderBrush="{StaticResource Ink}" BorderThickness="2" VerticalAlignment="Center">
              <Rectangle x:Name="knob" Width="10" Height="10" Fill="{StaticResource Ink}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource Ink}"/>
              <Setter TargetName="knob" Property="Fill" Value="{StaticResource Bg}"/>
              <Setter TargetName="knob" Property="Margin" Value="23,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control (RadioButtons). -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Padding="4,10" Background="Transparent">
            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Ink}"/>
              <Setter TargetName="cp" Property="TextElement.Foreground" Value="{StaticResource Bg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress: a dashed route with an ink bar and a hazard tip. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="12"/>
    <Setter Property="Maximum" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Line X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeDashArray="3,3" VerticalAlignment="Center"/>
            <Border x:Name="PART_Track" Background="Transparent"/>
            <Border x:Name="PART_Indicator" Background="{StaticResource Ink}" HorizontalAlignment="Left" ClipToBounds="True">
              <Rectangle x:Name="tip" Width="14" HorizontalAlignment="Right" Fill="{StaticResource HazardFine}"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Value" Value="1">
              <Setter TargetName="tip" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim square scroll bars. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border Background="{StaticResource Steel}"/></ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Border Background="{StaticResource Steel}"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Lists without selection chrome. -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#33F2F2F1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
