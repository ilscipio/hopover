<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hopover" Width="520" Height="340" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="False">
  <Grid Margin="20">
    <Border CornerRadius="24" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="24" Background="{StaticResource Glow}" ClipToBounds="True"/>
    <Grid Margin="40,34,40,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Image x:Name="Logo" Source="{StaticResource Logo}" Width="58" Height="58" RenderTransformOrigin="0.5,1">
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="LogoScale"/>
              <TranslateTransform x:Name="LogoHop"/>
            </TransformGroup>
          </Image.RenderTransform>
        </Image>
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Hopover" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="SemiBold"/>
          <TextBlock Text="Move to your new PC. All of it." Foreground="{StaticResource TextDim}" FontSize="14" Margin="1,2,0,0"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2">
        <TextBlock x:Name="Status" Text="Starting" Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,0,0,12"/>
        <!-- Indeterminate bar: a gradient slice slides across the track. -->
        <Border x:Name="Track" Height="4" CornerRadius="2" Background="{StaticResource Surface3}" ClipToBounds="True">
          <Border x:Name="Slice" Width="140" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource AccentGradientH}">
            <Border.RenderTransform>
              <TranslateTransform x:Name="SliceX" X="-140"/>
            </Border.RenderTransform>
          </Border>
        </Border>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,4,0,0">
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnRetry" Style="{StaticResource Primary}" Content="Try again" Margin="0,0,10,0"/>
            <Button x:Name="BtnQuit" Content="Close"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="Version" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextFaint}" FontSize="11.5"/>
    </Grid>
  </Grid>
</Window>
