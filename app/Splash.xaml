<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Hopover.App;assembly=Hopover"
        Title="Hopover" Width="560" Height="360" WindowStyle="None" ResizeMode="NoResize" Background="{StaticResource Ink}" FontFamily="{StaticResource Body}" FontSize="15" Foreground="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="False" UseLayoutRounding="True">
  <Grid>
    <h:HazardBar Height="10" VerticalAlignment="Top" Period="16"/>
    <Rectangle Stroke="{StaticResource Ink2}" StrokeThickness="2" IsHitTestVisible="False"/>
    <Grid Margin="44,40,44,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <h:HopMark x:Name="Mark" Height="132" Width="110" Animate="True" Stem="#DCDDDD" Arch="#FF5A1F" Shadow="#DCDDDD"/>
        <TextBlock Text="opover" Foreground="{StaticResource Bg}" FontFamily="{StaticResource Display}" FontSize="62" VerticalAlignment="Bottom" Margin="-12,0,0,2"/>
      </StackPanel>

      <TextBlock x:Name="Version" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Light}"/>
      <TextBlock Grid.Row="1" Text="Move to your new PC. All of it." Foreground="{StaticResource Light}" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,10"/>

      <StackPanel Grid.Row="2">
        <TextBlock x:Name="Status" Text="Starting" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Light}" Margin="0,0,0,10"/>
        <h:HopLoader x:Name="Track" Height="44" Width="300" HorizontalAlignment="Left" StemFrom="#DCDDDD"/>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,4,0,0">
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource Signal}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnRetry" Style="{StaticResource OnInk}" Content="Try again" Margin="0,0,10,0" Height="44"/>
            <Button x:Name="BtnQuit" Style="{StaticResource OnInk}" Content="Close" Height="44"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
