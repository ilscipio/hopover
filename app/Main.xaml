<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Hopover.App;assembly=Hopover"
        Title="Hopover" Width="1280" Height="800" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="{StaticResource Body}" FontSize="15" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>

    <!-- One stop of the route (vertical): a node on a dashed line; done stops are solid. -->
    <DataTemplate x:Key="StepTemplate">
      <Grid MinHeight="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Line x:Name="dash" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeDashArray="3,3"
              HorizontalAlignment="Left" Margin="9,24,0,-2"/>
        <Rectangle x:Name="solid" Width="4" Fill="{StaticResource Ink}" HorizontalAlignment="Left" Margin="8,24,0,-2" Visibility="Collapsed"/>
        <Border x:Name="node" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="2">
          <h:HazardBar x:Name="busy" Period="10" Visibility="Collapsed"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,0,16">
          <TextBlock Text="{Binding No}" Style="{StaticResource Eyebrow}"/>
          <TextBlock x:Name="label" Text="{Binding Label}" FontFamily="{StaticResource BodySemi}" FontSize="16" Foreground="{StaticResource Steel}" TextWrapping="Wrap"/>
          <TextBlock x:Name="det" Text="{Binding Detail}" Style="{StaticResource Eyebrow}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsLast}" Value="True">
          <Setter TargetName="dash" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="solid" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="running">
          <Setter TargetName="busy" Property="Visibility" Value="Visible"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="done">
          <Setter TargetName="node" Property="Background" Value="{StaticResource Ink}"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Ink}"/>
          <Setter TargetName="solid" Property="Visibility" Value="Visible"/>
          <Setter TargetName="dash" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="failed">
          <Setter TargetName="node" Property="Background" Value="{StaticResource Rust}"/>
          <Setter TargetName="node" Property="BorderBrush" Value="{StaticResource Rust}"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource RustDark}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="skipped">
          <Setter TargetName="node" Property="BorderBrush" Value="{StaticResource Light}"/>
          <Setter TargetName="node" Property="Background" Value="Transparent"/>
          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Light}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A stamp: stencil letters in a frame. -->
    <Style x:Key="StampText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoSemi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The huge coffee button: signal block, ink cup. -->
    <Style x:Key="CoffeeBig" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="bd" Background="{StaticResource Signal}" Padding="30,24">
                <ContentPresenter/>
              </Border>
              <Border Grid.Column="1" Background="{StaticResource Ink}">
                <Image Source="{StaticResource CupLight}" Width="92" Height="92"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF7A47"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: wordmark, the route, the sheet label. -->
    <Border Grid.ColumnSpan="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1">
      <Grid Margin="32,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource LogoH}" Height="21" Stretch="Uniform"/>
          <TextBlock Text="opover" FontFamily="{StaticResource Display}" FontSize="23" Margin="0,0,0,1" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="RouteBar" Grid.Column="1" Height="12" Margin="32,0,28,0" VerticalAlignment="Center" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.06*"/>
            <ColumnDefinition Width="0.64*"/>
          </Grid.ColumnDefinitions>
          <Line Grid.ColumnSpan="3" X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeDashArray="3,3" VerticalAlignment="Center"/>
          <Border x:Name="RouteFill" Background="{StaticResource Ink}" Height="8"/>
          <h:HazardBar x:Name="RouteTip" Grid.Column="1" Height="8" Period="10"/>
        </Grid>
        <TextBlock x:Name="Crumb" Grid.Column="2" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Ink2}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnMin" Style="{StaticResource Caption}" Tag="{StaticResource GlyphMin}"/>
          <Button x:Name="BtnMax" Style="{StaticResource Caption}" Tag="{StaticResource GlyphMax}"/>
          <Button x:Name="BtnClose" Style="{StaticResource CaptionClose}" Tag="{StaticResource GlyphClose}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">

      <!-- ============ Pledge: the coffee deal, first start ============ -->
      <Grid x:Name="PagePledge" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="56,52,40,44">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock FontFamily="{StaticResource DisplayBlack}" FontSize="72" LineHeight="66" LineStackingStrategy="BlockLineHeight">
            <Run Text="Free to"/><LineBreak/><Run Text="move."/>
          </TextBlock>
          <Border Grid.Row="1" Background="{StaticResource Signal}" HorizontalAlignment="Left" Margin="-2,10,0,0" Padding="10,0,10,2">
            <TextBlock Text="PAY ON DELIVERY." FontFamily="{StaticResource Stencil}" FontSize="48"/>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,26,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Dim}" FontSize="16" LineHeight="23"
                       Text="Hi, Paul here. I built Hopover because no tool would move my whole dev PC - WSL, SSH keys, env vars and all. So go ahead and use it. Free. Every feature, no trial, no locked buttons."/>
            <TextBlock Style="{StaticResource Dim}" FontSize="16" LineHeight="23" Margin="0,10,0,0"
                       Text="The catch: you promise me a coffee at the end, once your move works. Pay what you want. A promise is a promise, so I will remind you once halfway through your files, and again at the end. Politely. With a very big button."/>
            <TextBlock Style="{StaticResource Dim}" FontSize="16" LineHeight="23" Margin="0,10,0,0"
                       Text="If it fails, you owe me nothing - not even the coffee. Send me the log and I'll fix it."/>
          </StackPanel>
          <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="BtnDeal" Style="{StaticResource Primary}" Content="Deal. Let's go" MinWidth="360" IsEnabled="False"/>
            <Button x:Name="BtnSource" Style="{StaticResource Ghost}" Content="Read the source first" Margin="28,0,0,0" FontSize="16"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource Ink}" ClipToBounds="True">
          <h:HazardBar Height="10" VerticalAlignment="Top" Period="16"/>
          <Border Width="400" Margin="50,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Paper}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><RotateTransform Angle="-2.5"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="26" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
            <StackPanel>
              <StackPanel Margin="26,22,26,18">
                <Grid>
                  <TextBlock Text="FREIGHT TICKET" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                  <TextBlock x:Name="TicketNo" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,1.5,0,0"/>
                  <TextBlock Text="FROM" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,10"/>
                  <TextBlock x:Name="TicketFrom" Grid.Column="1" FontFamily="{StaticResource MonoSemi}" FontSize="14" VerticalAlignment="Center"/>
                  <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"/>
                  <TextBlock Grid.Row="1" Text="TO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,10"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="your new PC" FontFamily="{StaticResource MonoSemi}" FontSize="14" VerticalAlignment="Center"/>
                  <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"/>
                  <TextBlock Grid.Row="2" Text="CARGO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,10"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Apps, keys, settings, WSL, files" FontSize="14" VerticalAlignment="Center"/>
                  <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1"/>
                  <TextBlock Grid.Row="3" Text="CHARGE NOW" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,10"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="0.00" FontFamily="{StaticResource DisplayBlack}" FontSize="34" Margin="0,2"/>
                </Grid>
              </StackPanel>
              <Grid Height="22" Margin="0,0,0,0">
                <Line X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeDashArray="3,3" Margin="14,0" VerticalAlignment="Center"/>
                <Ellipse Width="22" Height="22" Fill="{StaticResource Ink}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                <Ellipse Width="22" Height="22" Fill="{StaticResource Ink}" HorizontalAlignment="Right" Margin="0,0,-12,0"/>
              </Grid>
              <StackPanel Margin="26,14,26,24">
                <Grid>
                  <TextBlock Text="COFFEE COUPON · DUE ON DELIVERY" FontFamily="{StaticResource MonoSemi}" FontSize="13" VerticalAlignment="Center"/>
                  <Image Source="{StaticResource Cup}" Width="34" Height="34" HorizontalAlignment="Right"/>
                </Grid>
                <CheckBox x:Name="PledgeCheck" Margin="0,14,0,0">
                  <TextBlock x:Name="PledgeText" TextWrapping="Wrap" FontFamily="{StaticResource BodySemi}" FontSize="16" LineHeight="22"/>
                </CheckBox>
                <TextBlock x:Name="PriceNote" FontFamily="{StaticResource MonoSemi}" FontSize="12" Foreground="{StaticResource Steel}" Margin="34,8,0,0"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="SIGNED" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" Margin="0,0,12,3"/>
                  <Border Grid.Column="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="SignedLine" FontFamily="{StaticResource Mono}" FontSize="13" Margin="0,16,0,3"/>
                  </Border>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Bottom" Margin="50,0,50,40">
            <TextBlock Text="No account, no trial. Hopover can't even check if you paid - it runs on trust and a little guilt ;)" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Light}" TextWrapping="Wrap" LineHeight="19"/>
            <TextBlock x:Name="LicenceLine" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Light}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
        <Canvas x:Name="ArrowLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
          <Path x:Name="ArrowPath" Stroke="{StaticResource Signal}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <TextBlock x:Name="ArrowLabel" Text="Tick this first ;)" FontFamily="{StaticResource BodySemi}" FontSize="16" Foreground="{StaticResource Ink}"/>
        </Canvas>
      </Grid>

      <!-- ============ Start ============ -->
      <Grid x:Name="PageWelcome">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <StackPanel MaxWidth="1040" VerticalAlignment="Center" Margin="56,0">
          <TextBlock Text="PC MIGRATION OVER YOUR NETWORK" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Steel}"/>
          <TextBlock Margin="0,14,0,0" FontFamily="{StaticResource DisplayBlack}" FontSize="68" LineHeight="64" LineStackingStrategy="BlockLineHeight">
            <Run Text="Move to your"/><LineBreak/><Run Text="new PC. "/><Run Text="All of it." Foreground="{StaticResource Rust}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Dim}" FontSize="17" LineHeight="26" MaxWidth="640" HorizontalAlignment="Left" Margin="0,18,0,0"
                     Text="Apps, files, SSH keys, WSL, settings, scheduled tasks - all of it. Both PCs stay on in the same network, and the old PC only shares. Nothing on it changes."/>

          <UniformGrid Columns="2" Margin="-10,32,-10,0">
            <Button x:Name="BtnOld" Style="{StaticResource ChoiceCard}" Margin="10">
              <StackPanel>
                <TextBlock Text="CRATE A · FROM" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="This is the old PC" FontFamily="{StaticResource Display}" FontSize="28" Margin="0,10,0,6"/>
                <TextBlock Style="{StaticResource Dim}" Text="Scan it, choose what moves, and share it read-only with the new PC."/>
                <TextBlock Text="SCAN AND SHARE  →" FontFamily="{StaticResource MonoSemi}" FontSize="13" Margin="0,18,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnNew" Style="{StaticResource ChoiceCard}" Margin="10">
              <StackPanel>
                <TextBlock Text="CRATE B · TO" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="This is the new PC" FontFamily="{StaticResource Display}" FontSize="28" Margin="0,10,0,6"/>
                <TextBlock Style="{StaticResource Dim}" Text="Connect to the old PC and bring everything over. You can use this PC while it works."/>
                <TextBlock Text="CONNECT AND MOVE  →" FontFamily="{StaticResource MonoSemi}" FontSize="13" Margin="0,18,0,0"/>
              </StackPanel>
            </Button>
          </UniformGrid>

          <Border x:Name="ResumeBanner" Visibility="Collapsed" BorderBrush="{StaticResource Rust}" BorderThickness="3" Padding="16,10" Margin="0,16,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="UNFINISHED" FontFamily="{StaticResource MonoSemi}" FontSize="13" Foreground="{StaticResource RustDark}" VerticalAlignment="Center"/>
              <TextBlock Margin="16,0,0,0" Foreground="{StaticResource RustDark}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="760"
                         Text="A move on this PC did not finish. Choose 'This is the new PC': done steps are skipped and the copy goes on where it stopped."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ Old PC: scan and choose ============ -->
      <Grid x:Name="PageScan" Visibility="Collapsed" Margin="56,36,56,36">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="OLD PC  ·  STEP 1 OF 2  ·  THE MANIFEST" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="What moves" Style="{StaticResource H1}" Margin="0,8,0,8"/>
            <TextBlock x:Name="ScanSub" Style="{StaticResource Dim}" Text="Hopover measures every folder. You don't have to wait for it: the sizes only feed the progress bar."/>
            <TextBlock x:Name="CloudNote" Style="{StaticResource Eyebrow}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <ProgressBar x:Name="ScanBar" Margin="0,14,0,6"/>
            <TextBlock x:Name="ScanText" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Height="30" Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="146"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2"/>
              <TextBlock Grid.Column="1" Text="CRATE" Style="{StaticResource StencilText}" VerticalAlignment="Center" Margin="0,0,0,2"/>
              <TextBlock Grid.Column="2" Text="CONTENTS" Style="{StaticResource StencilText}" VerticalAlignment="Center" Margin="0,0,0,2"/>
              <TextBlock Grid.Column="3" Text="WEIGHT" Style="{StaticResource StencilText}" HorizontalAlignment="Right" Margin="0,0,18,2" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource StencilText}" VerticalAlignment="Center" Margin="0,0,0,2"/>
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="PlanList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid x:Name="row" MinHeight="62">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="146"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"/>
                      <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock x:Name="nm" Text="{Binding Name}" FontFamily="{StaticResource BodySemi}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="wt" Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource MonoSemi}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>
                      <Border x:Name="stamp" Grid.Column="4" Height="34" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{StaticResource Ink}" BorderThickness="1.5">
                        <TextBlock x:Name="st" Text="LOADED" Style="{StaticResource StampText}" FontSize="13"/>
                      </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Include}" Value="False">
                        <Setter TargetName="nm" Property="Foreground" Value="{StaticResource Steel}"/>
                        <Setter TargetName="wt" Property="Foreground" Value="{StaticResource Steel}"/>
                        <Setter TargetName="st" Property="Text" Value="LEFT BEHIND"/>
                        <Setter TargetName="st" Property="Foreground" Value="{StaticResource Steel}"/>
                        <Setter TargetName="stamp" Property="BorderBrush" Value="{StaticResource Light}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="ScanWait" VerticalAlignment="Center" HorizontalAlignment="Center">
                <h:HopLoader Width="360" Height="82"/>
                <TextBlock Text="Reading the folders" Style="{StaticResource Eyebrow}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                <ItemsControl x:Name="ScanTicker" Width="600" Height="132" Margin="0,18,0,0" Focusable="False" IsHitTestVisible="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" Opacity="{Binding Fade}" FontFamily="{StaticResource Mono}" FontSize="12" Height="22" Foreground="{StaticResource Ink2}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Margin="0,4,0,0">
          <TextBlock Text="ALSO MOVE" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
          <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0" Padding="0,16,0,0">
            <StackPanel>
              <StackPanel x:Name="OldSteps"/>
              <StackPanel x:Name="OldCertPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock Text="Password for the certificates" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="OldCertPw"/>
                <TextBlock Text="You type it again on the new PC." Style="{StaticResource Eyebrow}" Margin="0,6,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Margin="0,10,0,0">
            <TextBlock Text="TOTAL" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            <Button x:Name="BtnSavePlan" Style="{StaticResource Ghost}" Content="Save this list as text" HorizontalAlignment="Right"/>
          </Grid>
          <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="TotalBig" Text="..." FontFamily="{StaticResource DisplayBlack}" FontSize="36"/>
              <TextBlock x:Name="TotalSub" Style="{StaticResource Dim}" FontSize="13" LineHeight="19"/>
              <Border x:Name="PairBox" Visibility="Collapsed" BorderBrush="{StaticResource Rust}" BorderThickness="3" Padding="14,6" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="PAIRING CODE FOR THE NEW PC" Style="{StaticResource Eyebrow}"/>
                  <TextBlock x:Name="ScanCode" FontFamily="{StaticResource MonoSemi}" FontSize="19" Margin="0,2,0,0"/>
                  <TextBlock x:Name="ScanPeer" Visibility="Collapsed" Style="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
              <Button x:Name="BtnExport" Style="{StaticResource Primary}" Content="Prepare the move" FontSize="18" Margin="0,8,0,0" IsEnabled="False"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ Old PC: prepare and share ============ -->
      <Grid x:Name="PageExport" Visibility="Collapsed" Margin="56,36,56,36">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="OLD PC  ·  STEP 2 OF 2  ·  THE ROUTE" Style="{StaticResource Eyebrow}"/>
          <TextBlock x:Name="ExportTitle" Text="Preparing the move" Style="{StaticResource H1}" FontSize="32" LineHeight="34" Margin="0,8,0,24" TextWrapping="Wrap"/>
          <ItemsControl x:Name="ExportSteps" ItemTemplate="{StaticResource StepTemplate}"/>
        </StackPanel>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border x:Name="ExportWorking" Style="{StaticResource Card}" Padding="28">
            <StackPanel>
              <h:HopLoader Width="420" Height="98" HorizontalAlignment="Left"/>
              <TextBlock Text="Saving the app list, settings, tasks and WSL" Style="{StaticResource H2}" Margin="0,14,0,0"/>
              <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" Text="WSL distros stop while they are saved. Then Hopover shows a pairing code for the new PC."/>
            </StackPanel>
          </Border>
          <Border x:Name="ShareCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="28">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Ready. Now go to the new PC." FontFamily="{StaticResource Display}" FontSize="28"/>
                  <TextBlock x:Name="ShareWhere" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource Ink}" BorderThickness="3" Padding="12,0" VerticalAlignment="Top" Margin="20,0,0,0">
                  <TextBlock Text="DELIVERED" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                </Border>
              </Grid>
              <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0" Padding="0,10,0,0" Margin="0,22,0,0">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="BtnCopyCode" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="COPY" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                    <TextBlock Text="PAIRING CODE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="LinkCode" FontFamily="{StaticResource Display}" FontSize="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Border x:Name="LinkBadge" BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="10,2" VerticalAlignment="Center">
                  <TextBlock x:Name="LinkBadgeText" Text="WAITING FOR THE NEW PC" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                </Border>
                <TextBlock x:Name="LinkPeer" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Dim}" Margin="0,18,0,0" Text="Leave this PC on until the new PC says Done. The code works for one try: a wrong guess makes a new code. No Windows password is needed. Files travel straight between the two PCs, encrypted."/>
              <Button x:Name="BtnStopShare" Content="Stop the link (after the move)" HorizontalAlignment="Left" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnExportLog" Grid.Row="1" Style="{StaticResource Ghost}" Content="Show details" HorizontalAlignment="Left" Margin="0,10,0,6"/>
          <Border x:Name="ExportLogBorder" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="1.5">
            <TextBox x:Name="ExportLog" IsReadOnly="True" FontSize="12" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Foreground="{StaticResource Ink2}"/>
          </Border>
        </Grid>
      </Grid>

      <!-- ============ New PC: connect ============ -->
      <ScrollViewer x:Name="PageConnect" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
        <StackPanel Width="800" HorizontalAlignment="Left" Margin="56,36,0,36">
          <TextBlock Text="NEW PC  ·  STEP 1 OF 2" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Connect to the old PC" Style="{StaticResource H1}" Margin="0,8,0,8"/>
          <TextBlock Style="{StaticResource Dim}" Text="The old PC shows a pairing code after 'Prepare the move'. Type it here."/>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="WHERE IS THE OLD PC" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <Border BorderBrush="{StaticResource Ink}" BorderThickness="2" HorizontalAlignment="Left">
                <UniformGrid Columns="3">
                  <RadioButton x:Name="ModeLan" GroupName="linkmode" Style="{StaticResource Segment}" Content="Same network" IsChecked="True" MinWidth="170"/>
                  <RadioButton x:Name="ModeCable" GroupName="linkmode" Style="{StaticResource Segment}" Content="Direct cable" MinWidth="170"/>
                  <RadioButton x:Name="ModeNet" GroupName="linkmode" Style="{StaticResource Segment}" Content="Over the internet" MinWidth="170"/>
                </UniformGrid>
              </Border>
              <TextBlock x:Name="ModeHint" Style="{StaticResource Dim}" FontSize="13" LineHeight="19" Margin="0,10,0,0"/>
              <TextBlock Text="PAIRING CODE" Style="{StaticResource Eyebrow}" Margin="0,18,0,6"/>
              <TextBox x:Name="CodeBox" FontFamily="{StaticResource Display}" FontSize="26"/>
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnConnect" Content="Connect" MinWidth="140"/>
                <h:HazardBar x:Name="ConnectSpin" Width="70" Height="10" Period="12" Margin="16,0,0,0" Visibility="Collapsed"/>
                <Border x:Name="ConnectBadge" BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="10,2" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock x:Name="ConnectBadgeText" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                </Border>
                <TextBlock x:Name="ConnectText" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="460"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="ImportCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="CRATE B · TO THIS PC" Style="{StaticResource Eyebrow}"/>
              <TextBlock x:Name="SummaryTitle" FontFamily="{StaticResource Display}" FontSize="24" Margin="0,6,0,0"/>
              <TextBlock x:Name="SummaryText" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
              <Rectangle Style="{StaticResource Rule}" Margin="0,20"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="WHAT MOVES" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                  <StackPanel x:Name="NewSteps"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="SPEED" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                  <Border BorderBrush="{StaticResource Ink}" BorderThickness="2">
                    <UniformGrid Columns="3">
                      <RadioButton x:Name="SpeedGentle" GroupName="speed" Style="{StaticResource Segment}" Content="Gentle"/>
                      <RadioButton x:Name="SpeedBalanced" GroupName="speed" Style="{StaticResource Segment}" Content="Balanced" IsChecked="True"/>
                      <RadioButton x:Name="SpeedFull" GroupName="speed" Style="{StaticResource Segment}" Content="Full speed"/>
                    </UniformGrid>
                  </Border>
                  <TextBlock x:Name="SpeedHint" Style="{StaticResource Dim}" FontSize="13" LineHeight="19" Margin="0,10,0,0"/>
                  <StackPanel x:Name="NewCertPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Text="CERTIFICATE PASSWORD FROM THE OLD PC" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewCertPw"/>
                  </StackPanel>
                  <CheckBox x:Name="DrySwitch" Style="{StaticResource Switch}" Margin="0,20,0,0">
                    <StackPanel>
                      <TextBlock Text="Preview first" FontFamily="{StaticResource BodySemi}"/>
                      <TextBlock Text="Write what would happen to a text file; change nothing." Style="{StaticResource Eyebrow}"/>
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnCatchupNow" Content="Catch up" Visibility="Collapsed" MinWidth="160" Margin="0,0,12,0"/>
                <Button x:Name="BtnImport" Style="{StaticResource Primary}" Content="Start the move" MinWidth="320"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ New PC: the move ============ -->
      <Grid x:Name="PageImport" Visibility="Collapsed" Margin="56,36,56,36">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="NEW PC  ·  STEP 2 OF 2  ·  THE ROUTE" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="ImportTitle" Text="Moving to this PC" Style="{StaticResource H1}" FontSize="32" LineHeight="34" Margin="0,8,0,24" TextWrapping="Wrap"/>
            <ItemsControl x:Name="ImportSteps" ItemTemplate="{StaticResource StepTemplate}"/>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="HeroCard">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="HeroPct" Text="0" FontFamily="{StaticResource DisplayBlack}" FontSize="130" LineHeight="104" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="%" FontFamily="{StaticResource Stencil}" FontSize="48" Margin="6,0,0,6" VerticalAlignment="Bottom"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <TextBlock x:Name="HeroBytes" Text="Waiting for the files step" FontFamily="{StaticResource Display}" FontSize="22" HorizontalAlignment="Right"/>
                <TextBlock x:Name="HeroRate" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Ink2}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <ProgressBar x:Name="HeroBar" Margin="0,14,0,10"/>
            <h:HazardBar x:Name="HeroHazard" Height="8" Period="12" Visibility="Collapsed"/>
            <h:HopLoader x:Name="HeroWait" Height="64" Width="300" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <TextBlock x:Name="HeroItem" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"
                       Text="Apps install in the background while the files copy. Sign in to 1Password and OneDrive meanwhile."/>
          </StackPanel>

          <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="28">
            <StackPanel>
              <Border x:Name="DoneStamp" BorderBrush="{StaticResource Rust}" BorderThickness="3" Padding="12,0" HorizontalAlignment="Left">
                <TextBlock x:Name="DoneStampText" Text="STOPPED" FontFamily="{StaticResource MonoSemi}" FontSize="13" Foreground="{StaticResource RustDark}"/>
              </Border>
              <TextBlock x:Name="DoneTitle" Text="The move stopped" FontFamily="{StaticResource Display}" FontSize="26" TextWrapping="Wrap" Margin="0,14,0,0"/>
              <TextBlock x:Name="DoneText" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,22,0,0">
                <Button x:Name="BtnPreviewOpen" Content="Open the preview" Visibility="Collapsed" Margin="0,0,10,10"/>
                <Button x:Name="BtnReconnect" Content="Connect again" Visibility="Collapsed" Margin="0,0,10,10"/>
                <Button x:Name="BtnSignIn" Content="Sign in to your accounts" Margin="0,0,10,10"/>
                <Button x:Name="BtnCatchup" Content="Catch up with the old PC" Margin="0,0,10,10"/>
                <Button x:Name="BtnChecklist" Content="Open the checklist" Margin="0,0,10,10"/>
                <Button x:Name="BtnCleanup" Content="Clean up" Margin="0,0,10,10"/>
                <Button x:Name="BtnTasks" Content="Turn on scheduled tasks" Margin="0,0,10,10"/>
                <Button x:Name="BtnVerify" Content="Check again" Margin="0,0,10,10"/>
                <Button x:Name="BtnLogs" Content="Open log folder" Margin="0,0,10,10"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <StackPanel x:Name="ActivePanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="CRATES IN TRANSIT" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0">
              <ItemsControl x:Name="ActiveList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="50">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"/>
                      <TextBlock Text="{Binding Code}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource MonoSemi}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                      <Border Grid.Column="3" Height="30" Padding="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Signal}">
                        <TextBlock Text="IN TRANSIT" Style="{StaticResource StampText}" FontSize="13"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <Button x:Name="BtnImportLog" Grid.Row="2" Style="{StaticResource Ghost}" Content="Show details" HorizontalAlignment="Left" Margin="0,10,0,6"/>
          <Border x:Name="ImportLogBorder" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="1.5">
            <TextBox x:Name="ImportLog" IsReadOnly="True" FontSize="12" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Foreground="{StaticResource Ink2}"/>
          </Border>
        </Grid>
      </Grid>

      <!-- ============ Checkpoint: the first apps are on the new PC ============ -->
      <Grid x:Name="PageCheckpoint" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="56,48,56,40">
          <TextBlock Text="CHECKPOINT · FIRST CRATES UNPACKED" Style="{StaticResource Eyebrow}" FontSize="11"/>
          <TextBlock Margin="0,14,0,0" FontFamily="{StaticResource DisplayBlack}" FontSize="58" LineHeight="54" LineStackingStrategy="BlockLineHeight">
            <Run Text="Take one for"/><LineBreak/><Run Text="a test drive."/>
          </TextBlock>
          <TextBlock Style="{StaticResource Dim}" FontSize="17" LineHeight="26" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,24"
                     Text="These apps already made it over. Open one and check that it still remembers you - the copy keeps going in the background."/>
          <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0">
            <ItemsControl x:Name="CheckApps">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="60">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodySemi}" FontSize="18"/>
                      <TextBlock Text="{Binding Check}" Foreground="{StaticResource Steel}" Margin="14,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Uid="open" Tag="{Binding}" Content="Open" Height="44" Padding="16,0" Background="{StaticResource Ink}" BorderThickness="0"
                              Foreground="{StaticResource Bg}" Margin="0,0,8,0" Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"/>
                      <Button Uid="broken" Tag="{Binding}" Content="It is broken" Height="44" Padding="14,0" BorderThickness="1.5"
                              FontFamily="{StaticResource BodySemi}" FontSize="14"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Button x:Name="BtnCheckContinue" Content="Back to the move" HorizontalAlignment="Left" Margin="0,22,0,0"/>
        </StackPanel>

        <Grid x:Name="CheckNote" Grid.Column="1" Width="520" Background="{StaticResource Ink}" ClipToBounds="True">
          <StackPanel Margin="48,48,48,0">
            <TextBlock Text="A QUICK NOTE FROM PAUL" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Light}"/>
            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Bg}" TextWrapping="Wrap" FontFamily="{StaticResource DisplayBlack}" FontSize="32" LineHeight="34" LineStackingStrategy="BlockLineHeight">
              <Run Text="Your apps made it."/><LineBreak/><Run Text="So did your promise."/>
            </TextBlock>
            <TextBlock x:Name="NoteText" Foreground="#D5D7D9" FontSize="16" LineHeight="24" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <Grid Margin="0,28,0,0" HorizontalAlignment="Left" Width="350" Height="120">
              <Border Width="340" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{StaticResource Paper}" Padding="20,18,20,16" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="3"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="20" Direction="270" Opacity="0.7" Color="Black"/></Border.Effect>
                <StackPanel>
                  <TextBlock Text="COFFEE COUPON · DUE ON DELIVERY" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                  <TextBlock x:Name="NoteQuote" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <TextBlock x:Name="NoteSigned" Style="{StaticResource Eyebrow}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-30" Background="#EB111213" BorderBrush="{StaticResource Signal}" BorderThickness="3" Padding="10,0"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-12"/></Border.RenderTransform>
                <TextBlock Text="STILL IN THE TRUCK" FontFamily="{StaticResource MonoSemi}" FontSize="13" Foreground="{StaticResource Signal}"/>
              </Border>
            </Grid>
          </StackPanel>
          <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,44">
            <Button x:Name="BtnPayNow" Style="{StaticResource OnInk}" Content="Buy the coffee now"/>
            <Button x:Name="BtnPayLater" Style="{StaticResource GhostOnInk}" Content="Later - when it's all done" Margin="0,10,0,0" Height="44"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ============ Done: the receipt ============ -->
      <Grid x:Name="PageDone" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="470"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="48,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="360">
          <Grid x:Name="Receipt" RenderTransformOrigin="0.5,0.5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Paper}" Padding="28,26,28,34">
              <StackPanel>
                <Grid>
                  <TextBlock Text="DELIVERY RECEIPT" FontFamily="{StaticResource MonoSemi}" FontSize="13"/>
                  <TextBlock x:Name="ReceiptNo" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Rectangle Height="1.5" Fill="{StaticResource Ink}" Margin="0,10,0,0"/>
                <ItemsControl x:Name="ReceiptLines">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,0">
                        <Border BorderBrush="{StaticResource Light}" BorderThickness="0,0,0,1" Padding="0,11">
                          <Grid>
                            <TextBlock Text="{Binding What}" FontSize="15"/>
                            <TextBlock Text="{Binding N}" FontFamily="{StaticResource MonoSemi}" FontSize="14" HorizontalAlignment="Right"/>
                          </Grid>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,14,0,0">
                  <TextBlock x:Name="ReceiptOpenLabel" Text="STILL OPEN" FontFamily="{StaticResource MonoSemi}" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ReceiptOpenValue" Text="1 coffee" FontFamily="{StaticResource Display}" FontSize="20" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Border>
            <Path Grid.Row="1" Height="14" Stretch="Fill" Fill="{StaticResource Paper}" Margin="0,-1,0,0"
                  Data="M0,0 H360 V2 L348,14 L336,2 L324,14 L312,2 L300,14 L288,2 L276,14 L264,2 L252,14 L240,2 L228,14 L216,2 L204,14 L192,2 L180,14 L168,2 L156,14 L144,2 L132,14 L120,2 L108,14 L96,2 L84,14 L72,2 L60,14 L48,2 L36,14 L24,2 L12,14 L0,2 Z"/>
            <Border x:Name="StampDelivered" Margin="30,0,0,-62" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="14,0,14,2"
                    BorderBrush="{StaticResource Ink}" BorderThickness="5">
              <TextBlock Text="DELIVERED" FontFamily="{StaticResource StencilBlack}" FontSize="62"/>
            </Border>
          </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="24,40,56,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="DoneBig" FontFamily="{StaticResource DisplayBlack}" FontSize="72" LineHeight="64" LineStackingStrategy="BlockLineHeight">
            <Run Text="Everything"/><LineBreak/><Run Text="made it."/>
          </TextBlock>
          <StackPanel x:Name="PaulBlock" Grid.Row="1" Margin="0,22,0,0" MaxWidth="580" HorizontalAlignment="Left">
            <TextBlock x:Name="PaulLine" Text="I was told people hate subscriptions. This is me hoping you return the favor." FontSize="21" LineHeight="30" TextWrapping="Wrap"/>
            <TextBlock Text="- PAUL" Style="{StaticResource Eyebrow}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
          <Button x:Name="BtnCoffee" Grid.Row="2" Style="{StaticResource CoffeeBig}" Height="196" Margin="0,28,0,0">
            <Grid>
              <TextBlock x:Name="CoffeeLabel" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
              <TextBlock FontFamily="{StaticResource DisplayBlack}" FontSize="58" LineHeight="52" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom">
                <Run Text="Buy Paul"/><LineBreak/><Run Text="a coffee"/>
              </TextBlock>
            </Grid>
          </Button>
          <Border x:Name="ThanksBlock" Grid.Row="2" Margin="0,28,0,0" Visibility="Collapsed" BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0" Padding="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Thanks for the coffee - genuinely. You made my day :)" FontFamily="{StaticResource DisplayBlack}" FontSize="30" LineHeight="34" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
              <TextBlock Style="{StaticResource Dim}" FontSize="17" LineHeight="26" Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Enjoy the new PC! And if something breaks later, send me the log and I'll take a look."/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="BtnReview" Content="Leave a review" Height="52" FontSize="16"/>
              <TextBlock Grid.Column="1" Text="And if you have two minutes: a review helps tremendously." Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="22,0,0,0"/>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="BtnDoneSignIn" Style="{StaticResource Ghost}" Content="Sign in to your accounts" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneCatchup" Style="{StaticResource Ghost}" Content="Catch up with the old PC" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneChecklist" Style="{StaticResource Ghost}" Content="Open the checklist" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneTasks" Style="{StaticResource Ghost}" Content="Turn on scheduled tasks" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneVerify" Style="{StaticResource Ghost}" Content="Check again" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneCleanup" Style="{StaticResource Ghost}" Content="Clean up" Margin="0,0,22,0"/>
              <Button x:Name="BtnDoneLogs" Style="{StaticResource Ghost}" Content="Open log folder"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ============ Checklist ============ -->
      <Grid x:Name="PageChecklist" Visibility="Collapsed" Margin="56,36,56,36">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="AFTER THE MOVE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Checklist" Style="{StaticResource H1}" Margin="0,8,0,8"/>
            <TextBlock x:Name="CheckCount" Style="{StaticResource Dim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="BtnCheckOpen" Content="Open as file" Margin="0,0,10,0"/>
            <Button x:Name="BtnCheckBack" Content="Back"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10">
          <ListBox x:Name="CheckList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock x:Name="head" Text="{Binding Text}" Style="{StaticResource StencilText}" FontSize="13" Foreground="{StaticResource RustDark}" Margin="0,14,0,4" Visibility="Collapsed"/>
                  <CheckBox x:Name="item" IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,8">
                    <StackPanel>
                      <TextBlock x:Name="itemText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15"/>
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Eyebrow}" Margin="0,3,0,0"
                                 Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                  </CheckBox>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="head" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="item" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="itemText" Property="Foreground" Value="{StaticResource Steel}"/>
                    <Setter TargetName="itemText" Property="TextDecorations" Value="Strikethrough"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>

    <!-- ============ Dialog ============ -->
    <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource Veil}">
      <Border Style="{StaticResource Card}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" FontFamily="{StaticResource Display}" FontSize="24" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Style="{StaticResource Dim}" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="DlgCancel" Content="Cancel" Margin="0,0,10,0" Height="46"/>
            <Button x:Name="DlgOk" Content="OK" Height="46" Background="{StaticResource Ink}" Foreground="{StaticResource Bg}" MinWidth="110"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
